# Database Configuration
DB_PASSWORD=your_secure_database_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/emmvee_careers
SPRING_DATASOURCE_USERNAME=root

# JWT Configuration
# IMPORTANT: Change this to a strong random secret in production (minimum 64 characters recommended)
JWT_SECRET=your_production_jwt_secret_key_at_least_64_characters_long
JWT_EXPIRATION=3600000

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
